{
  "name": "bravune",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/connector",
    "packages/types",
    "packages/validation"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:functions": "npm run build -w @bravune/api && npm run build -w @bravune/connector && esbuild functions/src/index.js --bundle --platform=node --format=cjs --external:firebase-admin --external:firebase-functions --outfile=functions/lib/index.js",
    "typecheck": "tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/connector/tsconfig.json",
    "test": "vitest run",
    "dev:api": "npm run dev -w @bravune/api",
    "dev:connector": "npm run dev -w @bravune/connector"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
